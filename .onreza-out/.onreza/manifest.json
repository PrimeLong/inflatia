{
  "version": 2,
  "layers": [
    {
      "name": "site",
      "target": "STATIC",
      "directory": "site"
    },
    {
      "name": "api",
      "target": "COMPUTE",
      "directory": "server",
      "entry": "server.mjs",
      "runtime": {
        "timeoutMs": 30000,
        "network": {
          "schemaVersion": "COMPUTE_NETWORK_V1",
          "exposure": "PUBLIC",
          "ports": [
            {
              "name": "http",
              "protocol": "http",
              "port": 3000,
              "binding": "primary"
            }
          ],
          "readiness": {
            "protocol": "tcp",
            "port": "http"
          },
          "allowFrom": []
        }
      }
    }
  ],
  "routes": [
    {
      "pattern": "^/api/.*$",
      "layer": "api",
      "priority": 20
    },
    {
      "pattern": "^/.*$",
      "layer": "site",
      "priority": 0
    }
  ],
  "meta": {
    "framework": {
      "name": "vite"
    },
    "app": "inflatia"
  }
}
